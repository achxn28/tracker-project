{
  "name": "tracker-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.ts",
    "test:postgres": "node --conditions=react-server --test tests/integration/*.test.ts",
    "db:backup": "node --conditions=react-server scripts/backup-sqlite.ts",
    "db:import": "node --conditions=react-server scripts/import-sqlite.ts",
    "db:restore": "node --conditions=react-server scripts/restore-sqlite.ts"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
